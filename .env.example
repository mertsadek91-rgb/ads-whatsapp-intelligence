# =============================================================================
#  Configuration
# =============================================================================
#  Copy to `.env` and fill in. Only the four marked REQUIRED are needed to
#  boot — everything else has a working default, and most of it is better set
#  from the in-app setup wizard than by hand.
#
#  Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

# ---- Core (REQUIRED) --------------------------------------------------------
# REQUIRED — MySQL 5.7+ or MariaDB 10.2+ (where JSON columns arrived). The
# upserts are written in the portable VALUES(col) form, so both work.
MYSQL_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# If your database requires TLS with a certificate nothing trusts (common on
# Coolify, Railway and self-hosted servers), append ?ssl=insecure — encrypted
# but NOT verified, so it does not stop an impostor. Prefer the setup wizard,
# which also accepts a CA certificate for real verification.
# REQUIRED — session signing key. At least 32 chars, never a placeholder.
SESSION_SECRET=
# REQUIRED — your Wati API host. The tenant id is auto-derived from the token
# if you omit it. This is the API host, NOT the dashboard URL (app.wati.io).
WATI_API_ENDPOINT=https://live-mt-server.wati.io/<TENANT_ID>
# REQUIRED — Wati bearer token (Wati dashboard -> API Docs / Developer).
# Paste the raw token; a leading "Bearer " is stripped for you.
WATI_ACCESS_TOKEN=

# ---- Server -----------------------------------------------------------------
PORT=3000
# Public origin of this app. Must match the OAuth redirect URI you register
# with Meta, which is <APP_BASE_URL>/api/meta/callback
APP_BASE_URL=http://localhost:3000
NODE_ENV=production
# Number of reverse proxies in front of this app. 0 = exposed directly.
# Set to 1 behind a single proxy (nginx, Caddy, Coolify) so the login rate
# limiter and the audit logs see the real client IP instead of the proxy,
# and so the secure session cookie can be set over TLS termination.
TRUST_PROXY_HOPS=0

# Email of the admin account created automatically on a completely fresh
# database, with a random password printed once to the server log. Only used
# for a headless install — the setup wizard asks for these directly.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# ---- Meta (Facebook) Marketing API ------------------------------------------
# From Meta App Dashboard -> Settings -> Basic. Needed for one-click OAuth and
# for automatically upgrading a short-lived token to a long-lived one.
META_APP_ID=
META_APP_SECRET=
# Optional seed token; the app stores and refreshes its own after first connect.
META_ACCESS_TOKEN=
# Your ad account id WITHOUT the "act_" prefix (Ads Manager -> account dropdown).
META_AD_ACCOUNT_ID=
META_SCOPES=ads_read,business_management
META_API_VERSION=v21.0
META_LOOKBACK_DAYS=120

# ---- How much history to import ---------------------------------------------
# One setting for both sources; the setup wizard asks for it and the Settings
# page changes it later. Three values:
#   (blank)      the default window above — META_LOOKBACK_DAYS, 120 days.
#   all          everything available. Meta retains about 37 months of
#                insights; Wati's contact list is always read whole.
#   YYYY-MM-DD   from that day.
DATA_SINCE=
# Whether the import also pulls WhatsApp message THREADS, not just the contact
# list. Off by default because it is the slowest part — one request per contact
# — but without it there is nothing for the AI to read. With a DATA_SINCE date,
# threads are fetched only for contacts created on or after it.
DATA_WATI_MESSAGES=false
# Former name for DATA_SINCE. Still honoured; DATA_SINCE wins when both are set.
PERIOD_SINCE=

# ---- AI (DeepSeek) ----------------------------------------------------------
# From platform.deepseek.com -> API Keys. Without it, conversation analysis is
# skipped; the rest of the app runs normally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Cost estimates only, used to populate the AI spend audit trail.
DEEPSEEK_INPUT_COST_PER_1M=0.28
DEEPSEEK_OUTPUT_COST_PER_1M=1.10
# Hard daily ceiling. Analysis stops rather than exceed it.
DEEPSEEK_DAILY_BUDGET_USD=10

# ---- Email (optional) -------------------------------------------------------
# Leave SMTP_HOST blank to disable report emails entirely — the mailer then
# becomes a safe no-op and the app behaves identically.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Scheduling -------------------------------------------------------------
# Nightly pipeline: sync -> analyze -> score -> email reports.
CRON_TIME=0 3 * * *
CRON_TIMEZONE=UTC
# Lightweight sync that keeps the live boards fresh. Blank disables it.
QUICK_SYNC_CRON=*/30 * * * *
QUICK_SYNC_ANALYZE_CAP=60
# 0=Sun .. 6=Sat — which day the weekly employee reports send.
WEEKLY_REPORT_DOW=1
AUTO_ANALYZE_CAP=25
NIGHTLY_ANALYZE_CAP=500

# ---- Working hours ----------------------------------------------------------
# Used to tell an after-hours unanswered lead apart from a neglected one.
# Also editable at runtime from the Settings page.
WORK_START_HOUR=9
WORK_END_HOUR=17
# 0=Sun .. 6=Sat. Comma-separated. e.g. "0,6" Sat+Sun, or "5" Friday.
WORK_OFF_DAYS=0,6

# ---- Advanced ---------------------------------------------------------------
# Where setup.json lives — the database credentials, session secret and
# encryption key the app needs BEFORE a database exists. Mount this as a volume
# so an install survives a container rebuild. Defaults to ./server/data.
# DATA_DIR=/var/lib/app

# Key that encrypts the credentials stored in the app_config table, so a
# database dump does not hand over the Meta, Wati and AI keys in plaintext.
# Generated and kept in setup.json if unset; set it explicitly to keep the key
# outside the container.
# APP_SECRET_KEY=

# Only set if the bundled Chromium is not found (PDF export).
# PUPPETEER_EXECUTABLE_PATH=
