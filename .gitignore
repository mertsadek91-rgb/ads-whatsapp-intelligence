# ---- Secrets: never commit real credentials ----
.env
.env.*
!.env.example
# setup.json holds the database password, the session secret, and the AES key
# that decrypts every stored API token. Git does NOT accept a trailing comment
# on a pattern line — it reads the comment as part of the path — so this one
# matched nothing for six commits and the file was committed. Keep comments on
# their own line here, always.
server/data/

# ---- Dependencies / build output ----
node_modules/
dist/
coverage/

# ---- Logs & scratch ----
*.log
__*

# ---- Generated reports / data dumps (never source) ----
reports/
*.csv
!*.template.csv
_*.json
_*.tmp

# ---- OS / editor ----
.DS_Store
Thumbs.db
server/server.err.log
